# Copier vers .env et compléter avec les vraies valeurs (ne jamais committer .env)

# MongoDB Atlas — Cluster0, base dédiée "site_meetafrican" (isolée de bfmobility)
# Remplacer <user>/<password> par un utilisateur DB dédié créé dans Atlas.
MONGO_URL=mongodb+srv://<user>:<password>@cluster0.fjomnjr.mongodb.net
MONGO_DB_NAME=site_meetafrican
MONGO_COLLECTION_PREFIX=maf_

# Auth
JWT_SECRET=change-me-generate-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

# Frontend (pour CORS)
FRONTEND_ORIGIN=http://localhost:5173

# PawaPay — https://dashboard.pawapay.io (sandbox puis production)
PAWAPAY_ENVIRONMENT=sandbox
PAWAPAY_API_TOKEN_SANDBOX=
PAWAPAY_API_TOKEN_PRODUCTION=
PAWAPAY_CALLBACK_SECRET=generate-a-random-secret-for-webhook-url
PAWAPAY_DEFAULT_COUNTRY=BFA

UPLOADS_DIR=./uploads
MAX_UPLOAD_BYTES=8388608
PUBLIC_BASE_URL=http://localhost:8000

# IA de vérification d'identité / modération photo (API Anthropic)
ANTHROPIC_API_KEY=
AI_MODERATION_MODEL=claude-sonnet-5

# Bootstrap du premier compte admin (back-office) — laisser vide une fois
# le compte créé, ou changer pour promouvoir un autre email.
ADMIN_BOOTSTRAP_EMAIL=admin@meetafrican.example
ADMIN_BOOTSTRAP_PASSWORD=change-me-strong-password
