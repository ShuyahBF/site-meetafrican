VITE_API_BASE_URL=http://localhost:8000/api

# Secret partagé exigé par le backend sur /api/vidal/* (voir backend/.env.example
# VIDAL_PROXY_SECRET — même valeur des deux côtés). Nécessairement visible dans le
# bundle JS livré au navigateur (Vite expose tout VITE_* publiquement) : ce n'est
# pas un vrai contrôle d'accès, juste un garde-fou contre les robots qui tomberaient
# sur l'URL cachée /secure sans jamais exécuter de JavaScript.
VITE_VIDAL_PROXY_SECRET=
